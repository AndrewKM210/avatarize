# System tools for the avatar pipeline. Install with: brew bundle
brew "uv"        # Python + dependency management (pyproject.toml)
brew "go"        # needed to build the Primitive CLI
brew "potrace"   # bitmap -> vector tracing (posterize + trace)
brew "resvg"     # SVG -> PNG rendering for exports
brew "exiftool"  # verify exports carry no metadata

# Optional: manual cleanup of the final SVG
cask "inkscape"
